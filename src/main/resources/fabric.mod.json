{
  "schemaVersion": 1,
  "id": "musiclooper",
  "version": "1.1.0-hotfix",
  "name": "Music Looper",
  "description": "让原版音乐连续循环播放，并把 config/musiclooper/music 里的第三方音乐加入随机播放列表。\n当第三方音乐数量达到设定门槛时，可以在配置里完全禁用原版音乐。",
  "authors": [
    "hemjj",
    "蓝色大肥鱼"
  ],
  "license": "GPL-3.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.arin.musiclooper.MusicLooper"
    ]
  },
  "mixins": [
    "musiclooper.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "java": ">=17"
  }
}
